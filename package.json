{
  "name": "blindorbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,yellow \"vite\" \"tsx watch server/index.ts\"",
    "web": "vite",
    "api": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "bootstrap": "node scripts/bootstrap.mjs",
    "zip": "node scripts/make-zip.mjs"
  },
  "dependencies": {
    "@tidecloak/js": "0.14.41",
    "@tidecloak/react": "0.14.33",
    "@tideorg/js": "0.14.29",
    "heimdall-tide": "0.14.41",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
